<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'project_percent_done.css?v=1.3.12-r1', :plugin => 'redmine_project_percent_done' %>
<% end %>

<h2><%= l(:label_project_percent_done_details) %></h2>

<% if project_percent_done_history_available?(@project) %>
  <p><%= link_to l(:label_project_percent_done_history_tab), project_percent_done_history_path(:project_id => @project.identifier) %></p>
<% end %>

<% included_url = project_percent_done_issues_filter_url(@project, @result.included_issue_ids) %>
<% not_included_url = project_percent_done_issues_filter_url(@project, @result.not_included_issue_ids) %>
<% visible_included_rows = project_percent_done_visible_rows(@result.included_rows) %>
<% visible_not_included_rows = project_percent_done_visible_rows(@result.not_included_rows) %>
<% hidden_included_count = project_percent_done_hidden_row_count(@result.included_rows) %>
<% hidden_not_included_count = project_percent_done_hidden_row_count(@result.not_included_rows) %>
<% total_weighted_value = @result.included_rows.sum(&:weighted_value) %>
<% included_status_options = visible_included_rows.map(&:status_name).compact.uniq.sort %>
<% included_note_options = visible_included_rows.flat_map { |row| row.notes.map { |note| project_percent_done_breakdown_note_label(note) } }.compact.uniq.sort %>
<% not_included_status_options = visible_not_included_rows.map(&:status_name).compact.uniq.sort %>
<% not_included_reason_options = visible_not_included_rows.map { |row| project_percent_done_breakdown_reason_label(row.reason) }.compact.uniq.sort %>

<div class="box project-percent-done">
  <h3><%= l(:label_project_percent_done_summary) %></h3>

  <p>
    <strong><%= l(:label_project_percent_done) %>:</strong>
    <%= project_percent_done_label(@result) %>
  </p>

  <%= progress_bar(@result.percent_done, :legend => project_percent_done_label(@result)) %>

  <table class="list">
    <tbody>
      <tr>
        <th><%= l(:label_project_percent_done_issue_count) %></th>
        <td>
          <% if included_url %>
            <%= link_to @result.issue_count, included_url %>
          <% else %>
            <%= @result.issue_count %>
          <% end %>
        </td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_not_included_issue_count) %></th>
        <td>
          <% if not_included_url %>
            <%= link_to @result.not_included_issue_count, not_included_url %>
          <% else %>
            <%= @result.not_included_issue_count %>
          <% end %>
        </td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_estimated_issue_count) %></th>
        <td><%= @result.estimated_issue_count %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_unestimated_issue_count) %></th>
        <td><%= @result.unestimated_issue_count %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_excluded_non_progress_issue_count) %></th>
        <td><%= @result.excluded_non_progress_issue_count %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_excluded_non_progress_estimated_hours) %></th>
        <td><%= number_with_precision(@result.excluded_non_progress_estimated_hours, :precision => 2) %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_excluded_non_progress_applied_weight) %></th>
        <td><%= number_with_precision(@result.excluded_non_progress_applied_weight, :precision => 2) %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_total_weight) %></th>
        <td><%= number_with_precision(@result.total_weight, :precision => 2) %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_non_progress_statuses) %></th>
        <td><%= @result.non_progress_status_names.any? ? h(@result.non_progress_status_names.join(', ')) : '-' %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_non_progress_trackers) %></th>
        <td><%= @result.non_progress_tracker_names.any? ? h(@result.non_progress_tracker_names.join(', ')) : '-' %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_issue_scope) %></th>
        <td><%= l(:label_project_percent_done_leaf_issues_only) %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_closed_issue_mode) %></th>
        <td><%= l(:"label_project_percent_done_#{ProjectPercentDone::Settings.closed_issue_mode}") %></td>
      </tr>
      <tr>
        <th><%= l(:label_project_percent_done_unestimated_issue_mode) %></th>
        <td><%= l(:"label_project_percent_done_#{ProjectPercentDone::Settings.unestimated_issue_mode}") %></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="box project-percent-done">
  <h3><%= l(:label_project_percent_done_formula) %></h3>
  <p><code><%= l(:text_project_percent_done_formula) %></code></p>
  <ul>
    <li><%= l(:text_project_percent_done_note_leaf_issues) %></li>
    <li><%= l(:text_project_percent_done_note_subprojects) %></li>
    <li><%= l(:text_project_percent_done_absolute_progress_notice) %></li>
  </ul>
</div>

<p class="warning project-percent-done-warning" style="color: #b00020; font-weight: bold;">
  <%= l(:text_project_percent_done_visibility_warning) %>
</p>

<div class="box ppd-issue-list-section ppd-collapsible-section" data-ppd-section="included">
  <div class="contextual">
    <%= link_to 'CSV', project_percent_done_path(:project_id => @project, :format => :csv, :table => 'included'), :class => 'icon icon-save', :title => l(:tooltip_project_percent_done_csv_included) %>
  </div>
  <h3><button type="button" class="ppd-section-toggle" data-ppd-toggle-section="included" aria-expanded="false"><span class="ppd-section-toggle-icon" aria-hidden="true">+</span><%= l(:label_project_percent_done_included_issues) %></button></h3>
  <div class="ppd-collapsible-body" data-ppd-section-body="included" hidden>
    <% if hidden_included_count.positive? %>
      <p class="warning"><%= l(:text_project_percent_done_hidden_included_issues, :count => hidden_included_count) %></p>
    <% end %>

    <div class="ppd-table-filter" data-ppd-filter-controls="ppd-included-issues">
      <label>
        <span><%= l(:label_project_percent_done_filter) %></span>
        <input type="search"
               data-ppd-filter-search
               placeholder="<%= l(:text_project_percent_done_filter_placeholder) %>">
      </label>
      <label>
        <span><%= l(:field_status) %></span>
        <select data-ppd-filter-status>
          <option value=""><%= l(:label_project_percent_done_all_statuses_filter) %></option>
          <% included_status_options.each do |status_name| %>
            <option value="<%= h(status_name) %>"><%= h(status_name) %></option>
          <% end %>
        </select>
      </label>
      <label>
        <span><%= l(:label_project_percent_done_notes) %></span>
        <select data-ppd-filter-secondary>
          <option value=""><%= l(:label_project_percent_done_all_notes_filter) %></option>
          <% included_note_options.each do |note| %>
            <option value="<%= h(note) %>"><%= h(note) %></option>
          <% end %>
        </select>
      </label>
      <div class="ppd-filter-chips" role="group" aria-label="<%= l(:label_project_percent_done_quick_filters) %>">
        <button type="button" data-ppd-quick-filter="" class="ppd-filter-chip ppd-filter-chip-active"><%= l(:label_all) %></button>
        <button type="button" data-ppd-quick-filter="closed_as_100" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_closed_as_100) %></button>
        <button type="button" data-ppd-quick-filter="has_notes" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_has_notes) %></button>
        <button type="button" data-ppd-quick-filter="estimated" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_estimated) %></button>
        <button type="button" data-ppd-quick-filter="unestimated" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_unestimated) %></button>
        <button type="button" data-ppd-quick-filter="complete" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_complete) %></button>
        <button type="button" data-ppd-quick-filter="incomplete" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_incomplete) %></button>
      </div>
      <span class="ppd-filter-count" data-ppd-filter-count></span>
    </div>

<table class="list issues ppd-issue-table" id="ppd-included-issues" data-ppd-filter-table>
  <thead>
    <tr>
      <th>#</th>
      <th class="ppd-issue-subject"><%= l(:field_subject) %></th>
      <th><%= l(:field_status) %></th>
      <th><%= l(:field_done_ratio) %></th>
      <th><%= l(:label_project_percent_done_effective_done_ratio) %></th>
      <th><%= l(:field_estimated_hours) %></th>
      <th><%= l(:label_project_percent_done_applied_weight) %></th>
      <th><%= l(:label_project_percent_done_weighted_value) %></th>
      <th><%= l(:label_project_percent_done_notes) %></th>
    </tr>
  </thead>
  <tbody>
    <% visible_included_rows.each do |row| %>
      <% note_labels = row.notes.map { |note| project_percent_done_breakdown_note_label(note) } %>
      <% quick_filters = [] %>
      <% quick_filters << 'closed_as_100' if row.notes.map(&:to_s).include?('closed_issue_treated_as_100') %>
      <% quick_filters << 'has_notes' if note_labels.any? %>
      <% quick_filters << (row.estimated_hours.present? ? 'estimated' : 'unestimated') %>
      <% quick_filters << (row.effective_done_ratio.to_f >= 100.0 ? 'complete' : 'incomplete') %>
      <tr class="<%= cycle('odd', 'even') %>"
          data-ppd-filter-row="true"
          data-ppd-search="<%= h([row.issue_id, row.subject, row.status_name, row.original_done_ratio, row.effective_done_ratio, row.estimated_hours, row.applied_weight, row.weighted_value, note_labels.join(' ')].join(' ')) %>"
          data-ppd-status="<%= h(row.status_name) %>"
          data-ppd-secondary="<%= h(note_labels.join('|||')) %>"
          data-ppd-quick="<%= h(quick_filters.join(' ')) %>">
        <td><%= link_to "##{row.issue_id}", issue_path(row.issue) %></td>
        <td class="ppd-issue-subject"><%= link_to h(row.subject), issue_path(row.issue) %></td>
        <td><%= h(row.status_name) %></td>
        <td><%= number_with_precision(row.original_done_ratio, :precision => 0) %>%</td>
        <td><%= number_with_precision(row.effective_done_ratio, :precision => 0) %>%</td>
        <td><%= row.estimated_hours.present? ? number_with_precision(row.estimated_hours, :precision => 2) : '-' %></td>
        <td><%= number_with_precision(row.applied_weight, :precision => 2) %></td>
        <td><%= number_with_precision(row.weighted_value, :precision => 2) %></td>
        <td><%= note_labels.join(', ') %></td>
      </tr>
    <% end %>
    <tr data-ppd-filter-empty hidden><td colspan="9"><%= l(:label_no_data) %></td></tr>
    <% if visible_included_rows.empty? %>
      <tr><td colspan="9"><%= l(:label_no_data) %></td></tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="6"><strong><%= l(:label_total) %></strong></td>
      <td><strong><%= number_with_precision(@result.total_weight, :precision => 2) %></strong></td>
      <td><strong><%= number_with_precision(total_weighted_value, :precision => 2) %></strong></td>
      <td>
        <strong>
          <%= l(:text_project_percent_done_total_formula,
                :weighted_value => number_with_precision(total_weighted_value, :precision => 2),
                :total_weight => number_with_precision(@result.total_weight, :precision => 2),
                :percent => project_percent_done_label(@result)) %>
        </strong>
      </td>
    </tr>
  </tfoot>
</table>
  </div>
</div>

<div class="box ppd-issue-list-section ppd-collapsible-section" data-ppd-section="not-included">
  <div class="contextual">
    <%= link_to 'CSV', project_percent_done_path(:project_id => @project, :format => :csv, :table => 'not_included'), :class => 'icon icon-save', :title => l(:tooltip_project_percent_done_csv_not_included) %>
  </div>
  <h3><button type="button" class="ppd-section-toggle" data-ppd-toggle-section="not-included" aria-expanded="false"><span class="ppd-section-toggle-icon" aria-hidden="true">+</span><%= l(:label_project_percent_done_not_included_issues) %></button></h3>
  <div class="ppd-collapsible-body" data-ppd-section-body="not-included" hidden>
    <% if hidden_not_included_count.positive? %>
      <p class="warning"><%= l(:text_project_percent_done_hidden_not_included_issues, :count => hidden_not_included_count) %></p>
    <% end %>

    <div class="ppd-table-filter" data-ppd-filter-controls="ppd-not-included-issues">
      <label>
        <span><%= l(:label_project_percent_done_filter) %></span>
        <input type="search"
               data-ppd-filter-search
               placeholder="<%= l(:text_project_percent_done_filter_placeholder) %>">
      </label>
      <label>
        <span><%= l(:field_status) %></span>
        <select data-ppd-filter-status>
          <option value=""><%= l(:label_project_percent_done_all_statuses_filter) %></option>
          <% not_included_status_options.each do |status_name| %>
            <option value="<%= h(status_name) %>"><%= h(status_name) %></option>
          <% end %>
        </select>
      </label>
      <label>
        <span><%= l(:label_project_percent_done_reason) %></span>
        <select data-ppd-filter-secondary>
          <option value=""><%= l(:label_project_percent_done_all_reasons_filter) %></option>
          <% not_included_reason_options.each do |reason| %>
            <option value="<%= h(reason) %>"><%= h(reason) %></option>
          <% end %>
        </select>
      </label>
      <div class="ppd-filter-chips" role="group" aria-label="<%= l(:label_project_percent_done_quick_filters) %>">
        <button type="button" data-ppd-quick-filter="" class="ppd-filter-chip ppd-filter-chip-active"><%= l(:label_all) %></button>
        <button type="button" data-ppd-quick-filter="parent_issue_excluded" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_parent_issues) %></button>
        <button type="button" data-ppd-quick-filter="non_progress_status" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_non_progress_status) %></button>
        <button type="button" data-ppd-quick-filter="non_progress_tracker" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_non_progress_tracker) %></button>
        <button type="button" data-ppd-quick-filter="unestimated_issue_ignored" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_ignored_unestimated) %></button>
        <button type="button" data-ppd-quick-filter="not_in_calculation_scope" class="ppd-filter-chip"><%= l(:label_project_percent_done_filter_other_scope) %></button>
      </div>
      <span class="ppd-filter-count" data-ppd-filter-count></span>
    </div>

<table class="list issues ppd-issue-table" id="ppd-not-included-issues" data-ppd-filter-table>
  <thead>
    <tr>
      <th>#</th>
      <th class="ppd-issue-subject"><%= l(:field_subject) %></th>
      <th><%= l(:field_status) %></th>
      <th><%= l(:field_done_ratio) %></th>
      <th><%= l(:field_estimated_hours) %></th>
      <th><%= l(:label_project_percent_done_reason) %></th>
    </tr>
  </thead>
  <tbody>
    <% visible_not_included_rows.each do |row| %>
      <% reason_label = project_percent_done_breakdown_reason_label(row.reason) %>
      <tr class="<%= cycle('odd', 'even') %>"
          data-ppd-filter-row="true"
          data-ppd-search="<%= h([row.issue_id, row.subject, row.status_name, row.original_done_ratio, row.estimated_hours, reason_label].join(' ')) %>"
          data-ppd-status="<%= h(row.status_name) %>"
          data-ppd-secondary="<%= h(reason_label) %>"
          data-ppd-quick="<%= h(row.reason) %>">
        <td><%= link_to "##{row.issue_id}", issue_path(row.issue) %></td>
        <td class="ppd-issue-subject"><%= link_to h(row.subject), issue_path(row.issue) %></td>
        <td><%= h(row.status_name) %></td>
        <td><%= number_with_precision(row.original_done_ratio, :precision => 0) %>%</td>
        <td><%= row.estimated_hours.present? ? number_with_precision(row.estimated_hours, :precision => 2) : '-' %></td>
        <td><%= reason_label %></td>
      </tr>
    <% end %>
    <tr data-ppd-filter-empty hidden><td colspan="6"><%= l(:label_no_data) %></td></tr>
    <% if visible_not_included_rows.empty? %>
      <tr><td colspan="6"><%= l(:label_no_data) %></td></tr>
    <% end %>
  </tbody>
</table>
  </div>
</div>

<script>
  (function() {
    function normalize(value) {
      return (value || '').toString().toLocaleLowerCase();
    }

    function selectedSecondaryMatches(rowValue, selectedValue) {
      if (!selectedValue) return true;
      return rowValue.split('|||').indexOf(selectedValue) !== -1;
    }

    function setSectionExpanded(button, expanded) {
      var sectionName = button.dataset.ppdToggleSection;
      var body = document.querySelector('[data-ppd-section-body="' + sectionName + '"]');
      var icon = button.querySelector('.ppd-section-toggle-icon');

      button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      if (body) body.hidden = !expanded;
      if (icon) icon.textContent = expanded ? '-' : '+';
    }

    function refreshFilter(control) {
      var table = document.getElementById(control.dataset.ppdFilterControls);
      if (!table) return;

      var search = normalize((control.querySelector('[data-ppd-filter-search]') || {}).value);
      var status = (control.querySelector('[data-ppd-filter-status]') || {}).value || '';
      var secondary = (control.querySelector('[data-ppd-filter-secondary]') || {}).value || '';
      var activeQuick = control.querySelector('.ppd-filter-chip-active');
      var quick = activeQuick ? activeQuick.dataset.ppdQuickFilter : '';
      var rows = Array.prototype.slice.call(table.querySelectorAll('[data-ppd-filter-row]'));
      var emptyRow = table.querySelector('[data-ppd-filter-empty]');
      var visibleCount = 0;

      rows.forEach(function(row) {
        var matchesSearch = !search || normalize(row.dataset.ppdSearch).indexOf(search) !== -1;
        var matchesStatus = !status || row.dataset.ppdStatus === status;
        var matchesSecondary = selectedSecondaryMatches(row.dataset.ppdSecondary || '', secondary);
        var matchesQuick = !quick || (row.dataset.ppdQuick || '').split(' ').indexOf(quick) !== -1;
        var visible = matchesSearch && matchesStatus && matchesSecondary && matchesQuick;

        row.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (emptyRow) emptyRow.hidden = visibleCount !== 0 || rows.length === 0;

      var count = control.querySelector('[data-ppd-filter-count]');
      if (count) {
        count.textContent = '<%= j l(:text_project_percent_done_filter_count, :visible => "__visible__", :total => "__total__") %>'
          .replace('__visible__', visibleCount)
          .replace('__total__', rows.length);
      }
    }

    document.querySelectorAll('[data-ppd-filter-controls]').forEach(function(control) {
      if (control.dataset.ppdFilterBound === 'true') return;

      control.dataset.ppdFilterBound = 'true';
      control.addEventListener('input', function(event) {
        if (event.target.matches('[data-ppd-filter-search]')) refreshFilter(control);
      });
      control.addEventListener('change', function(event) {
        if (event.target.matches('select')) refreshFilter(control);
      });
      control.addEventListener('click', function(event) {
        var chip = event.target.closest('[data-ppd-quick-filter]');
        if (!chip) return;

        event.preventDefault();
        control.querySelectorAll('[data-ppd-quick-filter]').forEach(function(button) {
          button.classList.toggle('ppd-filter-chip-active', button === chip);
        });
        refreshFilter(control);
      });
      refreshFilter(control);
    });

    document.querySelectorAll('[data-ppd-toggle-section]').forEach(function(button) {
      if (button.dataset.ppdToggleBound === 'true') return;
      button.dataset.ppdToggleBound = 'true';

      button.addEventListener('click', function() {
        setSectionExpanded(button, button.getAttribute('aria-expanded') !== 'true');
      });
    });
  })();
</script>

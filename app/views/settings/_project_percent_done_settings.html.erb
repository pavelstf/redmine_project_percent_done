<% @settings = ProjectPercentDone::Settings.form_values(@settings) %>
<% non_progress_status_scope = @settings['non_progress_status_scope'].presence || ProjectPercentDone::Settings::DEFAULTS['non_progress_status_scope'] %>
<% non_progress_tracker_scope = @settings['non_progress_tracker_scope'].presence || ProjectPercentDone::Settings::DEFAULTS['non_progress_tracker_scope'] %>
<% closed_non_progress_statuses = IssueStatus.where(:is_closed => true).sorted.to_a %>
<% all_non_progress_statuses = IssueStatus.sorted.to_a %>
<% non_progress_statuses =
     case non_progress_status_scope
     when 'all'
       all_non_progress_statuses
     when 'closed_only'
       closed_non_progress_statuses
     else
       []
     end %>
<% non_progress_status_option_data = {
     'none' => [],
     'closed_only' => closed_non_progress_statuses.map { |status| { :id => status.id.to_s, :name => status.name } },
     'all' => all_non_progress_statuses.map { |status| { :id => status.id.to_s, :name => status.name } }
   } %>
<% selected_non_progress_status_ids = Array(@settings['non_progress_status_ids']).map(&:to_s) %>
<% selected_non_progress_tracker_ids = Array(@settings['non_progress_tracker_ids']).map(&:to_s) %>
<% all_non_progress_trackers = Tracker.sorted.to_a %>
<% setting_help_button = lambda do |help_key, label_key|
     content_tag(
       :button,
       '',
       type: 'button',
       class: 'icon icon-help ppd-setting-help',
       data: { tooltip: l(help_key) },
       aria: {
         label: l(:label_project_percent_done_setting_help, setting: l(label_key)),
         controls: 'ppd-settings-tooltip',
         describedby: 'ppd-settings-tooltip',
         expanded: 'false'
       }
     )
   end %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'project_percent_done.css?v=1.3.14-r1', plugin: 'redmine_project_percent_done' %>
<% end %>

<fieldset class="box">
  <legend><%= l(:label_project_percent_done_display_locations) %></legend>

  <p>
    <%= hidden_field_tag 'settings[display_overview]', '0' %>
    <label>
      <%= check_box_tag 'settings[display_overview]', '1', @settings['display_overview'].to_s == '1' %>
      <%= l(:label_project_percent_done_display_overview) %>
    </label><%= setting_help_button.call(:help_project_percent_done_display_overview, :label_project_percent_done_display_overview) %>
  </p>

  <p>
    <%= hidden_field_tag 'settings[display_sidebar]', '0' %>
    <label>
      <%= check_box_tag 'settings[display_sidebar]', '1', @settings['display_sidebar'].to_s == '1' %>
      <%= l(:label_project_percent_done_display_sidebar) %>
    </label><%= setting_help_button.call(:help_project_percent_done_display_sidebar, :label_project_percent_done_display_sidebar) %>
  </p>

  <p>
    <%= hidden_field_tag 'settings[display_project_tab]', '0' %>
    <label>
      <%= check_box_tag 'settings[display_project_tab]', '1', @settings['display_project_tab'].to_s == '1' %>
      <%= l(:label_project_percent_done_display_project_tab) %>
    </label><%= setting_help_button.call(:help_project_percent_done_display_project_tab, :label_project_percent_done_display_project_tab) %>
  </p>

  <p>
    <%= hidden_field_tag 'settings[enable_rest_api]', '0' %>
    <label>
      <%= check_box_tag 'settings[enable_rest_api]', '1', @settings['enable_rest_api'].to_s == '1' %>
      <%= l(:label_project_percent_done_enable_rest_api) %>
    </label><%= setting_help_button.call(:help_project_percent_done_enable_rest_api, :label_project_percent_done_enable_rest_api) %>
  </p>

</fieldset>

<fieldset class="box">
  <legend><%= l(:label_project_percent_done_calculation_settings) %></legend>

  <p>
    <label><%= l(:label_project_percent_done_issue_scope) %></label><%= setting_help_button.call(:help_project_percent_done_issue_scope, :label_project_percent_done_issue_scope) %>
    <%= select_tag 'settings[issue_scope]',
      options_for_select(
        [
          [l(:label_project_percent_done_leaf_issues_only), 'leaf_issues_only']
        ],
        @settings['issue_scope']
      ) %>
  </p>

  <p>
    <label><%= l(:label_project_percent_done_non_progress_status_scope) %></label><%= setting_help_button.call(:help_project_percent_done_non_progress_status_scope, :label_project_percent_done_non_progress_status_scope) %>
    <%= select_tag 'settings[non_progress_status_scope]',
      options_for_select(
        [
          [l(:label_project_percent_done_no_status_exclusions), 'none'],
          [l(:label_project_percent_done_closed_statuses_only), 'closed_only'],
          [l(:label_project_percent_done_all_statuses), 'all']
        ],
        non_progress_status_scope
      ),
      :id => 'ppd-non-progress-status-scope' %>
  </p>

  <p>
    <label><%= l(:label_project_percent_done_non_progress_statuses) %></label><%= setting_help_button.call(:help_project_percent_done_non_progress_statuses, :label_project_percent_done_non_progress_statuses) %>
    <%= hidden_field_tag 'settings[non_progress_status_ids][]', '' %>
    <%= select_tag 'settings[non_progress_status_ids][]',
      options_for_select(
        non_progress_statuses.map { |status| [status.name, status.id] },
        selected_non_progress_status_ids
      ),
      :multiple => true,
      :size => [non_progress_statuses.size, 6].min.clamp(2, 8),
      :id => 'ppd-non-progress-status-ids',
      :disabled => non_progress_status_scope == 'none',
      :data => { :status_options => non_progress_status_option_data.to_json } %>
  </p>

  <p>
    <label><%= l(:label_project_percent_done_non_progress_tracker_scope) %></label><%= setting_help_button.call(:help_project_percent_done_non_progress_tracker_scope, :label_project_percent_done_non_progress_tracker_scope) %>
    <%= select_tag 'settings[non_progress_tracker_scope]',
      options_for_select(
        [
          [l(:label_project_percent_done_no_tracker_exclusions), 'none'],
          [l(:label_project_percent_done_all_trackers), 'all']
        ],
        non_progress_tracker_scope
      ),
      :id => 'ppd-non-progress-tracker-scope' %>
  </p>

  <p>
    <label><%= l(:label_project_percent_done_non_progress_trackers) %></label><%= setting_help_button.call(:help_project_percent_done_non_progress_trackers, :label_project_percent_done_non_progress_trackers) %>
    <%= hidden_field_tag 'settings[non_progress_tracker_ids][]', '' %>
    <%= select_tag 'settings[non_progress_tracker_ids][]',
      options_for_select(
        all_non_progress_trackers.map { |tracker| [tracker.name, tracker.id] },
        selected_non_progress_tracker_ids
      ),
      :multiple => true,
      :size => [all_non_progress_trackers.size, 6].min.clamp(2, 8),
      :id => 'ppd-non-progress-tracker-ids',
      :disabled => non_progress_tracker_scope == 'none' %>
  </p>

  <p>
    <label><%= l(:label_project_percent_done_closed_issue_mode) %></label><%= setting_help_button.call(:help_project_percent_done_closed_issue_mode, :label_project_percent_done_closed_issue_mode) %>
    <%= select_tag 'settings[closed_issue_mode]',
      options_for_select(
        [
          [l(:label_project_percent_done_treat_closed_as_100), 'treat_as_100'],
          [l(:label_project_percent_done_use_done_ratio), 'use_done_ratio']
        ],
        @settings['closed_issue_mode']
      ) %>
  </p>

  <p>
    <label><%= l(:label_project_percent_done_unestimated_issue_mode) %></label><%= setting_help_button.call(:help_project_percent_done_unestimated_issue_mode, :label_project_percent_done_unestimated_issue_mode) %>
    <%= select_tag 'settings[unestimated_issue_mode]',
      options_for_select(
        [
          [l(:label_project_percent_done_use_average_estimate), 'use_average_estimate'],
          [l(:label_project_percent_done_use_weight_1), 'use_weight_1'],
          [l(:label_project_percent_done_ignore_unestimated), 'ignore'],
          [l(:label_project_percent_done_equal_weight_all), 'equal_weight_all']
        ],
        @settings['unestimated_issue_mode']
      ) %>
  </p>

  <p>
    <label><%= l(:label_project_percent_done_rounding_mode) %></label><%= setting_help_button.call(:help_project_percent_done_rounding_mode, :label_project_percent_done_rounding_mode) %>
    <%= select_tag 'settings[rounding_mode]',
      options_for_select(
        [
          [l(:label_project_percent_done_nearest_integer), 'nearest_integer'],
          [l(:label_project_percent_done_floor), 'floor'],
          [l(:label_project_percent_done_ceil), 'ceil']
        ],
        @settings['rounding_mode']
      ) %>
  </p>
</fieldset>

<%= render :partial => 'settings/project_percent_done_history_settings',
           :locals => { :setting_help_button => setting_help_button } %>

<p class="info"><%= l(:text_project_percent_done_absolute_progress_notice) %></p>

<div id="ppd-settings-tooltip"
     class="ppd-settings-tooltip"
     role="tooltip"
     aria-hidden="true"
     hidden></div>

<script>
  (function() {
    var tooltip = document.getElementById('ppd-settings-tooltip');
    var activeTrigger = null;

    if (!tooltip || tooltip.dataset.bound === 'true') return;

    tooltip.dataset.bound = 'true';
    document.body.appendChild(tooltip);

    function positionTooltip(trigger) {
      window.requestAnimationFrame(function() {
        if (activeTrigger !== trigger || tooltip.hidden) return;

        var triggerRect = trigger.getBoundingClientRect();
        var tooltipRect = tooltip.getBoundingClientRect();
        var edgeGap = 8;
        var left = triggerRect.left + (triggerRect.width / 2) - (tooltipRect.width / 2);
        left = Math.max(edgeGap, Math.min(left, window.innerWidth - tooltipRect.width - edgeGap));

        var top = triggerRect.bottom + edgeGap;
        if (top + tooltipRect.height > window.innerHeight - edgeGap &&
            triggerRect.top - tooltipRect.height - edgeGap >= edgeGap) {
          top = triggerRect.top - tooltipRect.height - edgeGap;
        }

        tooltip.style.left = Math.round(left) + 'px';
        tooltip.style.top = Math.round(top) + 'px';
        tooltip.style.visibility = 'visible';
      });
    }

    function showTooltip(trigger) {
      if (activeTrigger && activeTrigger !== trigger) {
        activeTrigger.setAttribute('aria-expanded', 'false');
      }

      activeTrigger = trigger;
      tooltip.textContent = trigger.dataset.tooltip;
      tooltip.hidden = false;
      tooltip.style.visibility = 'hidden';
      tooltip.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      positionTooltip(trigger);
    }

    function hideTooltip(trigger) {
      if (!activeTrigger || (trigger && activeTrigger !== trigger)) return;

      activeTrigger.setAttribute('aria-expanded', 'false');
      activeTrigger = null;
      tooltip.hidden = true;
      tooltip.style.visibility = 'hidden';
      tooltip.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('.ppd-setting-help').forEach(function(trigger) {
      if (trigger.dataset.tooltipBound === 'true') return;

      trigger.dataset.tooltipBound = 'true';
      trigger.addEventListener('mouseenter', function() { showTooltip(trigger); });
      trigger.addEventListener('mouseleave', function() {
        if (document.activeElement !== trigger) hideTooltip(trigger);
      });
      trigger.addEventListener('focus', function() { showTooltip(trigger); });
      trigger.addEventListener('blur', function() { hideTooltip(trigger); });
      trigger.addEventListener('click', function(event) {
        event.preventDefault();
        event.stopPropagation();
        showTooltip(trigger);
      });
      trigger.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') {
          hideTooltip(trigger);
          trigger.blur();
        }
      });
    });

    document.addEventListener('click', function() { hideTooltip(); });
    window.addEventListener('resize', function() { hideTooltip(); });
    window.addEventListener('scroll', function() { hideTooltip(); }, true);
  })();

  (function() {
    var scopeSelect = document.getElementById('ppd-non-progress-status-scope');
    var statusSelect = document.getElementById('ppd-non-progress-status-ids');

    if (!scopeSelect || !statusSelect || statusSelect.dataset.statusScopeBound === 'true') return;

    statusSelect.dataset.statusScopeBound = 'true';

    function statusOptions() {
      try {
        return JSON.parse(statusSelect.dataset.statusOptions || '{}');
      } catch (error) {
        return {};
      }
    }

    function selectedValues() {
      return Array.prototype.map.call(statusSelect.selectedOptions, function(option) {
        return option.value;
      });
    }

    function refreshStatusSelect() {
      var scope = scopeSelect.value;
      var optionsByScope = statusOptions();
      var options = optionsByScope[scope] || [];
      var selected = selectedValues();

      while (statusSelect.firstChild) {
        statusSelect.removeChild(statusSelect.firstChild);
      }

      options.forEach(function(status) {
        var option = document.createElement('option');
        option.value = status.id;
        option.textContent = status.name;
        option.selected = selected.indexOf(status.id) !== -1;
        statusSelect.appendChild(option);
      });

      statusSelect.disabled = scope === 'none';
      statusSelect.size = Math.max(2, Math.min(options.length, 8));
    }

    scopeSelect.addEventListener('change', refreshStatusSelect);
    refreshStatusSelect();
  })();

  (function() {
    var scopeSelect = document.getElementById('ppd-non-progress-tracker-scope');
    var trackerSelect = document.getElementById('ppd-non-progress-tracker-ids');

    if (!scopeSelect || !trackerSelect || trackerSelect.dataset.trackerScopeBound === 'true') return;

    trackerSelect.dataset.trackerScopeBound = 'true';

    function refreshTrackerSelect() {
      trackerSelect.disabled = scopeSelect.value === 'none';
    }

    scopeSelect.addEventListener('change', refreshTrackerSelect);
    refreshTrackerSelect();
  })();
</script>
